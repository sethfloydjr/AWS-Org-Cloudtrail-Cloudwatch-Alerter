# Example variables. Copy to terraform.tfvars and edit for your environment.
# Every value below has a default in _variables.tf — override only what you need.

# ── AWS auth / placement ─────────────────────────────────────────────────────
default_region = "us-east-1"

# Organization root or OU ID that member accounts are created under.
# Find it with: aws organizations list-roots
parent_id = "r-abcd"

# The provider assumes a deploy role chosen by Terraform workspace — set it in
# _workspaces.tf (var.workspace_iam_roles), then select the workspace before
# plan/apply:  terraform workspace select root

# ── Organization member accounts ─────────────────────────────────────────────
org_prefix = "company"

# Base mailbox; each account gets a unique plus-addressed root email
# (aws+company-dev@company.com, ...). Override per account in org_accounts.
org_email = "aws@company.com"

# Add/remove accounts here — no resource or output code to touch.
# org_accounts = {
#   root         = {}
#   security     = {}
#   interconnect = {}
#   dev          = {}
#   prod         = { email = "aws+company-prod@company.com" }
# }

# ── CloudTrail storage ───────────────────────────────────────────────────────
# Must be globally unique.
bucket_name = "company-org-cloudtrail"

# Optional S3 server-access-log target buckets (must already exist in-region).
# s3_access_log_bucket       = "company-access-logs-us-east-1"
# s3_access_log_bucket_west2 = "company-access-logs-us-west-2"

# ── Alerting ─────────────────────────────────────────────────────────────────
alert_email = "security-alerts@company.com"

# Atlassian Cloud ID for the Jira API (publicly readable at
# https://<your-domain>.atlassian.net/_edge/tenant_info).
jira_cloud_id = "11111111-1111-1111-1111-111111111111"

# Optional Slack user-group to @-mention on every alert (e.g. on-call).
# slack_oncall_group_id = "S0123456789"
